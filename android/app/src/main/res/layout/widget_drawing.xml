<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_drawing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_drawing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:contentDescription="@string/widget_drawing_name"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_drawing_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/widget_draw_empty"
        android:textColor="@color/widget_icon"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>
