<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 26–28 have no system dark theme. API 29+ overrides this parent
      with Theme.DeviceDefault.DayNight (values-v29). The platform has no
      Theme.Material.DayNight style.
    -->
    <style name="Theme.Loviedowpie" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
