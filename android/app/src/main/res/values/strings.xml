    <string name="onboarding_title">Before you start</string>
    <string name="onboarding_intro">Loviedowpie is only for you and one partner. Sharing stays off until you turn it on.</string>
    <string name="name_label">Your name</string>
    <string name="name_help">Your partner sees this name. It is sent encrypted, only to them, after you pair.</string>
    <string name="photo_choose">Choose photo</string>
    <string name="photo_help">Optional. Stored on this phone and sent encrypted, only to your partner. A small photo, at most 48 KB.</string>
    <string name="photo_failed">Could not use that photo. Try a different one.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">Used when your partner rings this phone, and for the live-location notice. The notice does not include your coordinates.</string>
    <string name="perm_location_title">Location</string>
    <string name="perm_location_body">While sharing is on, this phone sends your coordinates and battery to your partner. The message is encrypted. The relay cannot read it. It is not sent to the map.</string>
    <string name="perm_background_title">Location all the time</string>
    <string name="perm_background_body">Android asks for this separately. Choose Allow all the time so an update can be sent about every 10 minutes while the app is closed. Without it, updates wait until you open the app.</string>
    <string name="perm_battery_title">Battery</string>
    <string name="perm_battery_body">Allowing unrestricted battery use keeps the 10-minute update closer to on time when the phone is asleep. It does not send any extra data.</string>
