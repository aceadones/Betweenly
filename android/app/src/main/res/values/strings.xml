    <string name="onboarding_title">Before you start</string>
    <string name="onboarding_intro">Betweenly is only for you and one partner. Sharing stays off until you turn it on.</string>
    <string name="name_label">Your name</string>
    <string name="name_help">Your partner sees this name. It is sent encrypted, only to them, after you pair.</string>
    <string name="photo_choose">Choose photo</string>
    <string name="photo_help">Optional. Stored on this phone and sent encrypted, only to your partner. A small photo, at most 48 KB.</string>
